# Copy to .env.local (development) or set these in your hosting panel (production).

# Public address of the site, used for canonical links, Open Graph tags and the sitemap.
APP_URL=http://localhost:3000

# PostgreSQL (Neon) connection string — use the pooled one ("-pooler" in the host).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=verify-full

# Only for scripts/migrate-mysql-to-postgres.mjs: the old MySQL database to copy data from.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=royalgasstove
DB_USER=root
DB_PASS=

# Long random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel Blob: when set, admin uploads are stored in Blob (required on Vercel, which has no permanent disk).
# Copy existing files from storage/uploads once with: node --env-file=.env.local scripts/upload-storage-to-blob.mjs
BLOB_READ_WRITE_TOKEN=

# Without Blob: where admin uploads (product photos, certificates, logo, reels, brochure) are stored.
# Keep it OUTSIDE the deployed build folder so redeploys never delete uploads.
# Default: ./storage/uploads
UPLOAD_DIR=

# Optional: SMTP for inquiry e-mail notifications (Admin → Settings → Notification email).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Royal Gas Stove Center
